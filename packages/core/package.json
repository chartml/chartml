{
  "name": "@chartml/core",
  "version": "3.1.0",
  "description": "ChartML chart rendering engine — Rust/WASM powered",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "node": "./pkg/node/chartml_wasm.js",
      "default": "./pkg/web/chartml_wasm.js"
    }
  },
  "files": ["dist/", "pkg/"],
  "scripts": {
    "build:wasm": "bash build.sh",
    "build:ts": "tsc",
    "build": "bash build.sh"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chartml/chartml.git",
    "directory": "packages/core"
  },
  "homepage": "https://chartml.org",
  "author": "Kyomi.ai",
  "keywords": ["chartml", "chart", "visualization", "wasm", "svg"],
  "license": "MIT"
}
