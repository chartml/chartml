{
  "name": "@chartml/markdown-it",
  "version": "1.2.0",
  "description": "markdown-it plugin for rendering ChartML code blocks",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js"
    },
    "./client": {
      "import": "./src/client.js",
      "require": "./src/client.js"
    },
    "./styles.css": {
      "import": "./src/styles.css",
      "require": "./src/styles.css",
      "default": "./src/styles.css"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "chartml",
    "markdown-it",
    "markdown",
    "charts",
    "visualization"
  ],
  "author": "Jason Adams",
  "license": "MIT",
  "peerDependencies": {
    "markdown-it": "^14.0.0",
    "@chartml/core": "^2.0.0",
    "@chartml/markdown-common": "^1.0.0",
    "@chartml/chart-pie": "^1.0.0",
    "@chartml/chart-scatter": "^1.0.0",
    "@chartml/chart-metric": "^1.0.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/chartml/chartml.git",
    "directory": "packages/markdown-it"
  },
  "homepage": "https://chartml.org"
}
