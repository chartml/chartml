            },
            "y": {
              "type": "boolean",
              "description": "Show horizontal grid lines"
            },
            "color": {
              "type": "string",
              "description": "Grid line color"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Grid line opacity (0-1)"
            },
            "dashArray": {
              "type": "string",
              "description": "Dash pattern for grid lines"
            }
          }
        },
        "showDots": {
          "type": "boolean",
          "description": "Show dots on line charts"
        },
        "strokeWidth": {
          "type": "number",
          "description": "Line thickness"
        },
        "fonts": {
          "type": "object",
          "properties": {
            "title": {
              "type": "object",
              "properties": {
                "family": { "type": "string" },
                "size": { "type": "number" },
                "weight": { "type": "number" },
                "color": { "type": "string" }
              }
            },
            "axis": {
              "type": "object",
              "properties": {
                "family": { "type": "string" },
                "size": { "type": "number" },
                "color": { "type": "string" }
              }
