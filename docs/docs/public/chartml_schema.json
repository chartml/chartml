            "dataLabel": {
              "type": "object",
              "properties": {
                "family": { "type": "string" },
                "size": { "type": "number" },
                "weight": { "type": "number" }
              }
            }
          }
        },
        "legend": {
          "type": "object",
          "properties": {
            "position": {
