#!/bin/bash
# Pre-commit hook: blocks lint suppressions and clippy warnings.

set -e

# --- Check 1: Reject new lint suppressions in staged files ---
echo "🔍 Checking for new lint suppressions..."

rs_violations=$(git diff --cached -- '*.rs' | grep '^+' | grep -v '^+++' | grep '#\[allow(' || true)
toml_violations=$(git diff --cached -- '*/Cargo.toml' 'Cargo.toml' | grep '^+' | grep -v '^+++' | grep '= "allow"' || true)

violations="${rs_violations}${toml_violations}"

if [ -n "$violations" ]; then
    echo ""
    echo "❌ New lint suppressions detected — commit blocked."
    echo ""
    [ -n "$rs_violations" ] && echo "In .rs files:" && echo "$rs_violations" && echo ""
    [ -n "$toml_violations" ] && echo "In Cargo.toml:" && echo "$toml_violations" && echo ""
    echo "Fix the lint warning instead of suppressing it."
    exit 1
fi

echo "✅ No new lint suppressions."

# --- Check 2: Cargo clippy ---
echo "🔍 Running cargo clippy..."

if ! clippy_output=$(cargo clippy --workspace --exclude chartml-wasm --exclude chartml-wasm-datafusion 2>&1); then
    printf '%s\n' "$clippy_output"
    echo "❌ Cargo clippy failed — commit blocked."
    exit 1
fi

warnings=$(printf '%s\n' "$clippy_output" \
    | grep "^warning:" \
    | grep -v "cargo:warning\|generated\|Model file\|Downloaded\|Downloading" \
    | grep -v '^warning: the following packages contain code that will be rejected by a future version of Rust:' \
    || true)

if [ -n "$warnings" ]; then
    echo ""
    echo "❌ Clippy warnings found — commit blocked."
    echo ""
    echo "$warnings"
    echo ""
    echo "Fix warnings and try again."
    exit 1
fi

echo "✅ Clippy clean."
